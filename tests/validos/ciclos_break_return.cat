// break solo sale del ciclo interno; return sale de toda la función
function buscar(matriz, objetivo) {
    for (let f = 0; f < len(matriz); f = f + 1) {
        let fila = matriz[f];
        let c = 0;
        while (c < len(fila)) {
            if (fila[c] == objetivo) {
                return [f, c];
            }
            c = c + 1;
        }
    }
    return [];
}
print(buscar([[1, 2], [3, 4], [5, 6]], 4));
print(buscar([[1, 2]], 9));

let pares = [];
for (let i = 0; i < 3; i = i + 1) {
    for (let j = 0; j < 3; j = j + 1) {
        if (j > i) { break; }
        push(pares, [i, j]);
    }
}
print(pares);

let n = 0;
for (n < 100) {
    n = n + 7;
}
print(n);
